{
	admin 0.0.0.0:2019 {
		# The host maps this port to 2019 (franken) and 2020 (franken-worker);
		# without these origins the admin API rejects browser requests
		# ("client is not allowed to access from origin ...").
		origins localhost:2019 localhost:2020 127.0.0.1:2019 127.0.0.1:2020
	}
	metrics
	auto_https off

	frankenphp
}

{$CADDY_EXTRA_CONFIG} 

{$SERVER_NAME::80} {
	root {$SERVER_ROOT:public/}
	encode zstd br gzip

	# Access logging - fills Ember's "Logs > Access" panel with a line per request.
	log

	{$CADDY_SERVER_EXTRA_DIRECTIVES}

	php_server
}
