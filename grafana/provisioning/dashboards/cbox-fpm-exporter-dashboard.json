{
  "title": "Cbox FPM Exporter",
  "uid": "cbox-fpm-exporter",
  "tags": [
    "php-fpm",
    "cbox"
  ],
  "timezone": "browser",
  "refresh": "5s",
  "time": {
    "from": "now-15m",
    "to": "now"
  },
  "panels": [
    {
      "datasource": "Prometheus",
      "id": 1,
      "type": "timeseries",
      "title": "Active vs Idle Workers",
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 0
      },
      "fieldConfig": {
        "defaults": {
          "color": {
            "mode": "palette-classic"
          },
          "custom": {
            "drawStyle": "line",
            "fillOpacity": 12,
            "lineWidth": 2,
            "showPoints": "never",
            "spanNulls": true,
            "lineInterpolation": "smooth",
            "stacking": {
              "group": "A",
              "mode": "none"
            }
          },
          "unit": "short",
          "mappings": [],
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom",
          "showLegend": true
        },
        "tooltip": {
          "mode": "multi",
          "sort": "none"
        }
      },
      "targets": [
        {
          "datasource": "Prometheus",
          "expr": "phpfpm_active_processes",
          "legendFormat": "active",
          "refId": "A"
        },
        {
          "datasource": "Prometheus",
          "expr": "phpfpm_idle_processes",
          "legendFormat": "idle",
          "refId": "B"
        }
      ]
    },
    {
      "datasource": "Prometheus",
      "id": 2,
      "type": "timeseries",
      "title": "Listen Queue (users waiting before PHP runs)",
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 0
      },
      "fieldConfig": {
        "defaults": {
          "color": {
            "mode": "palette-classic"
          },
          "custom": {
            "drawStyle": "line",
            "fillOpacity": 12,
            "lineWidth": 2,
            "showPoints": "never",
            "spanNulls": true,
            "lineInterpolation": "smooth",
            "stacking": {
              "group": "A",
              "mode": "none"
            }
          },
          "unit": "short",
          "mappings": [],
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom",
          "showLegend": true
        },
        "tooltip": {
          "mode": "multi",
          "sort": "none"
        }
      },
      "targets": [
        {
          "datasource": "Prometheus",
          "expr": "phpfpm_listen_queue",
          "legendFormat": "waiting now",
          "refId": "A"
        },
        {
          "datasource": "Prometheus",
          "expr": "phpfpm_listen_queue_length",
          "legendFormat": "kernel backlog limit",
          "refId": "B"
        }
      ]
    },
    {
      "datasource": "Prometheus",
      "id": 3,
      "type": "timeseries",
      "title": "Max Children Reached (capacity ceiling hits)",
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 8
      },
      "fieldConfig": {
        "defaults": {
          "color": {
            "mode": "palette-classic"
          },
          "custom": {
            "drawStyle": "line",
            "fillOpacity": 12,
            "lineWidth": 2,
            "showPoints": "never",
            "spanNulls": true,
            "lineInterpolation": "smooth",
            "stacking": {
              "group": "A",
              "mode": "none"
            }
          },
          "unit": "short",
          "mappings": [],
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom",
          "showLegend": true
        },
        "tooltip": {
          "mode": "multi",
          "sort": "none"
        }
      },
      "targets": [
        {
          "datasource": "Prometheus",
          "expr": "increase(phpfpm_max_children_reached[5m])",
          "legendFormat": "hits in 5m",
          "refId": "A"
        }
      ]
    },
    {
      "datasource": "Prometheus",
      "id": 4,
      "type": "timeseries",
      "title": "Accepted Connections / sec",
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 8
      },
      "fieldConfig": {
        "defaults": {
          "color": {
            "mode": "palette-classic"
          },
          "custom": {
            "drawStyle": "line",
            "fillOpacity": 12,
            "lineWidth": 2,
            "showPoints": "never",
            "spanNulls": true,
            "lineInterpolation": "smooth",
            "stacking": {
              "group": "A",
              "mode": "none"
            }
          },
          "unit": "ops",
          "mappings": [],
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom",
          "showLegend": true
        },
        "tooltip": {
          "mode": "multi",
          "sort": "none"
        }
      },
      "targets": [
        {
          "datasource": "Prometheus",
          "expr": "rate(phpfpm_accepted_connections[$__rate_interval])",
          "legendFormat": "req/s",
          "refId": "A"
        }
      ]
    },
    {
      "datasource": "Prometheus",
      "id": 5,
      "type": "timeseries",
      "title": "Peak Memory per Request (avg / max across workers)",
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 16
      },
      "fieldConfig": {
        "defaults": {
          "color": {
            "mode": "palette-classic"
          },
          "custom": {
            "drawStyle": "line",
            "fillOpacity": 12,
            "lineWidth": 2,
            "showPoints": "never",
            "spanNulls": true,
            "lineInterpolation": "smooth",
            "stacking": {
              "group": "A",
              "mode": "none"
            }
          },
          "unit": "bytes",
          "mappings": [],
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom",
          "showLegend": true
        },
        "tooltip": {
          "mode": "multi",
          "sort": "none"
        }
      },
      "targets": [
        {
          "datasource": "Prometheus",
          "expr": "avg(phpfpm_process_last_request_memory)",
          "legendFormat": "avg",
          "refId": "A"
        },
        {
          "datasource": "Prometheus",
          "expr": "max(phpfpm_process_last_request_memory)",
          "legendFormat": "max",
          "refId": "B"
        }
      ]
    },
    {
      "datasource": "Prometheus",
      "id": 6,
      "type": "timeseries",
      "title": "CPU of Last Request (avg / max across workers)",
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 16
      },
      "fieldConfig": {
        "defaults": {
          "color": {
            "mode": "palette-classic"
          },
          "custom": {
            "drawStyle": "line",
            "fillOpacity": 12,
            "lineWidth": 2,
            "showPoints": "never",
            "spanNulls": true,
            "lineInterpolation": "smooth",
            "stacking": {
              "group": "A",
              "mode": "none"
            }
          },
          "unit": "percent",
          "mappings": [],
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom",
          "showLegend": true
        },
        "tooltip": {
          "mode": "multi",
          "sort": "none"
        }
      },
      "targets": [
        {
          "datasource": "Prometheus",
          "expr": "avg(phpfpm_process_last_request_cpu)",
          "legendFormat": "avg",
          "refId": "A"
        },
        {
          "datasource": "Prometheus",
          "expr": "max(phpfpm_process_last_request_cpu)",
          "legendFormat": "max",
          "refId": "B"
        }
      ]
    }
  ],
  "schemaVersion": 39,
  "version": 1
}